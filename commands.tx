# 1. Derruba o Postgres nativo do Ubuntu para liberar a porta 5432
sudo systemctl stop postgresql

# 2. Sobe o container do banco de dados do nosso projeto em background
docker compose up -d

# 3. Garante que você está na branch certa para a nova funcionalidade
git checkout feature/ingestor-resilience

# 4. Roda o fork da mainnet pelo anvil 
anvil --fork-url https://mainnet.base.org

# 5. Simular uma Transação (Gatilho para o Go)
cast send --value 0.1ether 0x70997970C51812dc3A010C7d01b50e0d17dc79C8 --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 6. Consultar o Banco de Dados (Direto do Docker)
docker exec -it web3_shield_db psql -U admin -d web3shield -c "SELECT id, left(tx_hash, 10) as hash, to_address, function_signature, block_number FROM raw_transactions;"